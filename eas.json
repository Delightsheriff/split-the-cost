{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_USE_MOCK_API": "1" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_USE_MOCK_API": "1" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_MOCK_API": "0",
        "EXPO_PUBLIC_API_URL": "https://split-the-cost-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
