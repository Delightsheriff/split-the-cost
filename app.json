{
  "expo": {
    "name": "Split the Cost",
    "slug": "split-the-cost-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "splitthecostapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.delightsheriff.splitthecost",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#0B0B0D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.delightsheriff.splitthecost"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 136,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F1",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ee45978-ff50-46e7-a517-51b314541e50"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1ee45978-ff50-46e7-a517-51b314541e50"
    }
  }
}
