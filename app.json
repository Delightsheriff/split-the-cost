{
  "expo": {
    "name": "split-the-cost-app",
    "slug": "split-the-cost-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "splitthecostapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/screen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#102216"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
